<Window x:Class="Projecte_Kanban.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projecte_Kanban"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column 0: To Do -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,1">
            <Label Content="To Do" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel x:Name="ToDoPanel" Margin="5" />
        </Border>

        <!-- Column 1: In Progress -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,1">
            <Label Content="In Progress" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        </Border>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <StackPanel x:Name="InProgressPanel" Margin="5" />
        </Border>

        <!-- Column 2: Done -->
        <Border Grid.Row="0" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,0,1">
            <Label Content="Done" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        </Border>
        <Border Grid.Row="1" Grid.Column="2">
            <StackPanel x:Name="DonePanel" Margin="5" />
        </Border>
    </Grid>
</Window> 